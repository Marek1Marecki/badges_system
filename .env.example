# ==============================================================================
# .env.example
#
# DWIE ODRĘBNE WARSTWY zmiennych w tym projekcie (nie mylić):
#
# 1) Ten plik (.env w katalogu głównym) — czytany automatycznie przez
#    `docker compose` (nie przez Pydantic!). Dostarcza zmienne wymagane przez
#    same obrazy bazy danych/cache oraz identyfikatory obrazu aplikacji.
#
# 2) Pliki .env.dev / .env.test / .env.preprod / .env.prod — czytane przez
#    AppSettings (Pydantic) WEWNĄTRZ kontenera, wybierane przez ENV_FILE.
#    Dla PRE-PROD/PROD te pliki fizycznie NIE ISTNIEJĄ na dysku — wartości
#    wstrzykiwane są przez `environment:` w compose.preprod.yml/compose.prod.yml
#    (patrz sekcja "APLIKACJA" niżej — te same nazwy, inne miejsce dostawy).
#
# Skopiuj ten plik jako `.env` i uzupełnij wartości. Plik `.env` NIGDY nie
# trafia do repozytorium (patrz .gitignore).
# ==============================================================================

# --- COMPOSE: Baza danych (wymagane przez obraz postgis/postgis) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=badges_system_db

# --- COMPOSE: UID/GID dewelopera (opcjonalne, domyślnie 1000:1000) ---
# Na Linuksie ustaw: DEV_UID=$(id -u) / DEV_GID=$(id -g), żeby pliki tworzone
# w zamontowanym wolumenie ./:/app nie należały na hoście do roota.
DEV_UID=
DEV_GID=

# --- Wymagane przez scripts/bootstrap.sh (manage.py createsuperuser --noinput) ---
# Bez tych trzech zmiennych `createsuperuser --noinput` kończy się błędem
# (Django nie ma jak poprosić o dane interaktywnie w trybie --noinput).
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# --- COMPOSE: Redis — limit pamięci (opcjonalne, domyślnie 256mb) ---
# Zapobiega konkurowaniu Redis z PostgreSQL o RAM na tym samym hoście.
REDIS_MAXMEMORY=256mb

# --- COMPOSE: Monitoring Celery (Flower) — tylko DEV, profil 'monitoring' ---
FLOWER_USER=
FLOWER_PASSWORD=

# --- COMPOSE: Identyfikacja obrazu (wymagane przez compose.preprod.yml / compose.prod.yml) ---
# UWAGA: celowo BEZ wartości domyślnej dla IMAGE_TAG. "latest" jako przykład
# sugerowałby, że to bezpieczna wartość — w PRE-PROD/PROD zawsze wskazuj
# konkretny, niezmienny tag (np. SHA commita lub numer wersji z Release
# Registry), nigdy ruchomy `latest` (łamie Build Once, Deploy Many, ADR-020).
IMAGE_NAME=badges-system
IMAGE_TAG=

# --- APLIKACJA (PRE-PROD/PROD): wstrzykiwane jako `environment:` w compose,
#     NIE jako plik na dysku. Wypełnij realnymi wartościami w sekretach CI/CD. ---
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=

# --- COMPOSE: Reverse proxy PROD (Caddy — automatyczny HTTPS) ---
DOMAIN_NAME=

# --- Integracje zewnętrzne (współdzielone przez wszystkie środowiska aplikacyjne) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MAPY_CZ_API_KEY=
