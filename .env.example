# ==========================================
# Badges System - Szablon Konfiguracji
# Skopiuj do .env przed uruchomieniem
# ==========================================

# Core Django
SECRET_KEY=
DEBUG=True
APP_ENV=development
ALLOWED_HOSTS=localhost,127.0.0.1

# Baza danych (PostGIS)
DATABASE_URL=postgis://postgres:password@localhost:5432/badges_system_db

# Celery & Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Usługi zewnętrzne
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_SECONDS=40

# Logowanie
LOG_LEVEL=INFO
LOG_JSON=False

# Feature flags
FEATURE_OSM_NIGHT_WATCHMAN=True
FEATURE_PROXIMITY_SCAN=True

# Google OAuth2
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
