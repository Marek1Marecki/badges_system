# ==========================================
# Badges System - Środowisko Lokalne
# Zmień nazwę tego pliku na .env przed startem
# ==========================================

# Core Django
SECRET_KEY=twoj-super-tajny-klucz-de-vel-op-ment
DEBUG=True
APP_ENV=development
ALLOWED_HOSTS=localhost,127.0.0.1

# Baza danych (PostGIS)
DATABASE_URL=postgis://postgres:postgres@localhost:5432/badges_system_db

# Celery & Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Usługi zewnętrzne (Opcjonalne, mają bezpieczne wartości domyślne w kodzie)
# OVERPASS_API_URL=https://overpass-api.de/api/interpreter
# OVERPASS_TIMEOUT_SECONDS=30

# Logowanie
LOG_LEVEL=INFO
LOG_JSON=False