[importlinter]
root_packages =
    domain
    application
    infrastructure
    apps
include_external_packages = True

[importlinter:contract:domain-purity]
name = Domain must not import from application, infrastructure, apps or django
type = forbidden
source_modules = domain
forbidden_modules =
    application
    infrastructure
    apps
    django
    pydantic

[importlinter:contract:application-purity]
name = Application must not import from infrastructure, apps or django
type = forbidden
source_modules = application
forbidden_modules =
    infrastructure
    apps
    django

[importlinter:contract:apps-purity]
name = Apps Delivery Layer must not import infrastructure directly (except allowed integrations)
type = forbidden
source_modules = apps
forbidden_modules =
    infrastructure
ignore_imports =
    apps.tourists.context_processors -> infrastructure.config.map_layers
    apps.badges.tasks -> infrastructure.adapters.osm_adapter
    apps.badges.models -> infrastructure.schemas.badge_rules_schema