[importlinter]
root_packages =
    domain
    application
    infrastructure
    apps
    bootstrap
    config
include_external_packages = True

# ==============================================================================
# 1. TWIERDZA: CZYSTA DOMENA
# ==============================================================================
[importlinter:contract:domain-purity]
name = Domain must not import from application, infrastructure, apps, or any framework
type = forbidden
source_modules = domain
forbidden_modules =
    application
    infrastructure
    apps
    bootstrap
    config
    django
    pydantic
    celery
    requests

# ==============================================================================
# 2. ORKIESTRATOR: WARSTWA APLIKACJI
# ==============================================================================
[importlinter:contract:application-purity]
name = Application must not import from infrastructure, apps, config or django
type = forbidden
source_modules = application
forbidden_modules =
    infrastructure
    apps
    bootstrap
    config
    django
    celery

# ==============================================================================
# 3. ZASADY ZALEŻNOŚCI: DELIVERY I INFRASTRUKTURA
# ==============================================================================
#
# Wybór typu kontraktu: `forbidden` zamiast `layers`.
#
# W `import-linter` kierunek domyślny dla `layers` to `imports` (lewa warstwa
# może importować do prawej). Kolejność [infrastructure, apps] zatem
# *fizycznie zezwala* na importy apps -> infrastructure, co jest sprzeczne
# z nazwą i intencją reguły. Aby osiągnąć prawdziwe "must not depend",
# używamy `type = forbidden`, który domyślnie BLOKUJE wszystkie bezpośrednie
# importy z apps do infrastructure. Pozwala to na świadome, udokumentowane
# wyłomy w `ignore_imports` (Architecture Debt Register).
#
[importlinter:contract:hexagonal-layers]
name = Delivery Layer (Apps) must not depend on Infrastructure
type = forbidden
source_modules = apps
forbidden_modules = infrastructure
ignore_imports =
    # DŁUG-003: apps.tourists.context_processors -> infrastructure.config.map_layers
    # Powód: Context Processor w Django wstrzykuje warstwy map bezpośrednio
    #        do kontekstu szablonów HTML.
    # Target: Wydzielić serwis konfiguracyjny zwracający DTO map dla
    #         interfejsów (Faza D).
    apps.tourists.context_processors -> infrastructure.config.map_layers

    # EXC-001: apps.badges.tasks -> bootstrap
    # Powód: Zadania Celery nie mają dostępu do obiektu request (cykl HTTP),
    #        więc nie mogą otrzymać kontenera DI przez middleware. Jako jedyne
    #        miejsce w warstwie Deliveru, taski zachowują prawo do bezpośredniego
    #        importowania Composition Root.
    # Target: Brak — to jest zamierzony wyjątek architektoniczny.
    #
    # apps.badges.tasks -> bootstrap.container jest potrzebne jako osobna
    # pozycja, ponieważ import-linter 2.13 nie obsługuje łańcuchów
    # przechodnich w ignore_imports. Ignorując tę krawędź,
    # import-linter nie śledzi dalej do infrastructure.adapters.django_cache
    # (przez bootstrap.container), co zapobiega wykryciu fałszywego
    # naruszenia apps -> infrastructure.
    apps.badges.tasks -> bootstrap
    apps.badges.tasks -> bootstrap.container

# ==============================================================================
# 4. INFRASTRUKTURA: ZAKAZ INWERSJI KONTROLI (Kontener DI)
# ==============================================================================
[importlinter:contract:infrastructure-independence]
name = Infrastructure must not import Dependency Injection Container
type = forbidden
source_modules = infrastructure
forbidden_modules = bootstrap
ignore_imports =
    # DŁUG-004: infrastructure.adapters.celery_event_publisher -> apps.badges.tasks
    # Powód: Adapter zdarzeń importuje nazwę zadania Celery do rejestracji
    #        w punkcie końcowym (endpoint) wiadomości.
    # Target: Zastąpić bezpośredni import rejestracją opartą na nazwie
    #         ciągu znaków (string-based registry) lub slug.
    infrastructure.adapters.celery_event_publisher -> apps.badges.tasks
unrelated_modules =
    apps.badges.tasks

# ==============================================================================
# 5. ARCHITEKTURA HEKSAAGRALNA: INFRASTRUKTURA → DELIVERY (Apps)
# ==============================================================================
# Kierunek ten jest CZĘŚNIE słuszny w Django — adaptery ORM i infrastruktura
# muszą odnosić się do modeli Django (które mieszkają w apps/), aby wykonać
# zapytania SQL. Nie ma tu "czystej" inwersji zależności w klasycznym sensie.
#
# Kontrakt służy jako **tarcza zapobiegająca nowym wyciekom**: każdy nowy
# import z apps.* do infrastructure.* musi być udokumentowany jako świadoma
# decyzja (Architecture Debt Register), a nie powstawać przez przypadek.
# # ==============================================================================
[importlinter:contract:infra-to-apps-boundary]
name = Infrastructure must document dependencies on Apps layer
type = forbidden
source_modules = infrastructure
forbidden_modules = apps
ignore_imports =
    # DŁUG-005: infrastructure/adapters/osm_adapter.py -> apps.badges.models.OsmTypeMapping
    # Powód: Adaptery OSM używają modelu OsmTypeMapping (słownik typów OSM) do
    #        tłumaczenia typów zewnętrznych na wewnętrzne. Model ten jest
    #        jedynie enumem/konfiguracją danych, nie logiką domenową.
    # Target: Wyjąć enumy i statyczne słowniki do wspólnego modułu
    #         (domain/enums.py lub shared_kernel), aby infrastructura
    #         nie musiała importować modeli Django.
    infrastructure.adapters.osm_adapter -> apps.badges.models

    # DŁUG-006: infrastructure/adapters/persistence/django_tourist_repo.py -> apps.*
    # Powód: Adaptery repozytoriów Django muszą odwoływać się do modeli ORM
    #        (TouristProfile, AscentLog, UserBadgeProgress, etc.) do wykonywania
    #        zapytań SQL. W architekturze heksagonalnej w Django to nieuniknione —
    #        modele definiowane są w apps/, a adaptery w infrastrukturze.
    # Target: Stopniowo przenieść modele do infrastructure/ lub wdrożyć
    #         wzorzec ports-and-adapters z osobnym modelem domenowym.
    infrastructure.adapters.persistence.django_tourist_repo -> apps.badges.models
    infrastructure.adapters.persistence.django_tourist_repo -> apps.tourists.models

    # DŁUG-007: infrastructure/adapters/persistence/django_badge_repo.py -> apps.*
    # Powód: Ten sam wzorzec — repozytorium dostępu do odznak.
    infrastructure.adapters.persistence.django_badge_repo -> apps.badges.models

    # DŁUG-008: infrastructure/adapters/persistence/django_region_cache_repo.py -> apps.badges.models
    # Powód: Adaptery regionów i cache używają modeli turystycznych (ObjectRegionCache,
    #        TouristObject, TouristRegionModel) do zapytań GIS.
    infrastructure.adapters.persistence.django_region_cache_repo -> apps.badges.models

    # DŁUG-009: infrastructure/adapters/persistence/django_region_geometry_repo.py -> apps.badges.models
    # Powód: Geometria regionów w PostGIS wymaga modeli Django.
    infrastructure.adapters.persistence.django_region_geometry_repo -> apps.badges.models

    # DŁUG-010: infrastructure/adapters/persistence/django_proximity_repo.py -> apps.badges.models
    # Powód: Repozytorium proximity candidateów.
    infrastructure.adapters.persistence.django_proximity_repo -> apps.badges.models

    # DŁUG-011: infrastructure/adapters/persistence/django_explore_queries_repo.py -> apps.badges.models
    # Powód: Zapytania eksploracyjne dla mapy.
    infrastructure.adapters.persistence.django_explore_queries_repo -> apps.badges.models

    # DŁUG-012: infrastructure/adapters/persistence/django_mvt_repo.py -> apps.badges.models
    # Powód: Repozytorium MVT (Map Vector Tiles) dla renderowania map.
    infrastructure.adapters.persistence.django_mvt_repo -> apps.badges.models

    # DŁUG-013: infrastructure/adapters/persistence/django_map_repo.py -> apps.badges.models
    # Powód: Zapytania przestrzenne (ST_DWithin) dla mapy.
    infrastructure.adapters.persistence.django_map_repo -> apps.badges.models

    # DŁUG-014: infrastructure/adapters/persistence/django_news_repo.py -> apps.badges.models
    # Powód: Repozytorium dla newsów o odznakach.
    infrastructure.adapters.persistence.django_news_repo -> apps.badges.models

    # DŁUG-015: infrastructure/adapters/osm_repository.py -> apps.badges.models
    # Powód: Repozytorium synchronizacji OSM.
    infrastructure.adapters.osm_repository -> apps.badges.models

    # DŁUG-004: infrastructure/adapters/celery_event_publisher.py -> apps.badges.tasks
    # Powód: Zadania Celery rejestrowane przez import (patrz sekcja 4 powyżej).
    # Target: String-based task registry.
    infrastructure.adapters.celery_event_publisher -> apps.badges.tasks
    infrastructure.adapters.celery_event_publisher -> apps.tourists.models