digraph G {
  rankdir=LR;
  graph [splines=true, overlap=false];
  node [shape=box, style=filled, fontname=Helvetica];

  subgraph cluster_domain {
    label="domain";
    color=gray60;
    "domain" [fillcolor="lightblue"];
    "domain.entities" [fillcolor="lightblue"];
    "domain.entities.badge_version" [fillcolor="lightblue"];
    "domain.exceptions" [fillcolor="lightblue"];
    "domain.rules" [fillcolor="lightblue"];
    "domain.rules.badge_rules" [fillcolor="lightblue"];
    "domain.value_objects" [fillcolor="lightblue"];
    "domain.value_objects.ascent" [fillcolor="lightblue"];
  }

  subgraph cluster_application {
    label="application";
    color=gray60;
    "application" [fillcolor="lightgreen"];
    "application.dto" [fillcolor="lightgreen"];
    "application.dto.ascent_dto" [fillcolor="lightgreen"];
    "application.dto.user_context_dto" [fillcolor="lightgreen"];
    "application.dto.verify_badge_dto" [fillcolor="lightgreen"];
    "application.exceptions" [fillcolor="lightgreen"];
    "application.use_cases" [fillcolor="lightgreen"];
    "application.use_cases.build_tourist_region_geometry" [fillcolor="lightgreen"];
    "application.use_cases.calculate_object_regions" [fillcolor="lightgreen"];
    "application.use_cases.fetch_osm_data" [fillcolor="lightgreen"];
    "application.use_cases.log_ascent" [fillcolor="lightgreen"];
    "application.use_cases.scan_proximity_candidates" [fillcolor="lightgreen"];
    "application.use_cases.verify_badge" [fillcolor="lightgreen"];
  }

  subgraph cluster_ports {
    label="ports";
    color=gray60;
    "application.ports" [fillcolor="khaki"];
    "application.ports.badge_repository_port" [fillcolor="khaki"];
    "application.ports.clock_port" [fillcolor="khaki"];
    "application.ports.user_progress_port" [fillcolor="khaki"];
  }

  subgraph cluster_infrastructure {
    label="infrastructure";
    color=gray60;
    "infrastructure" [fillcolor="orange"];
    "infrastructure.adapters.clock" [fillcolor="orange"];
    "infrastructure.adapters.osm_adapter" [fillcolor="orange"];
    "infrastructure.adapters.osm_repository" [fillcolor="orange"];
    "infrastructure.adapters.persistence" [fillcolor="orange"];
    "infrastructure.adapters.persistence.django_badge_repo" [fillcolor="orange"];
    "infrastructure.adapters.persistence.region_cache_repo" [fillcolor="orange"];
    "infrastructure.config" [fillcolor="orange"];
    "infrastructure.config.app_settings" [fillcolor="orange"];
    "infrastructure.exceptions" [fillcolor="orange"];
    "infrastructure.logging" [fillcolor="orange"];
    "infrastructure.logging.log_config" [fillcolor="orange"];
    "infrastructure.schemas" [fillcolor="orange"];
    "infrastructure.schemas.badge_rules_schema" [fillcolor="orange"];
  }

  subgraph cluster_interface {
    label="interface";
    color=gray60;
    "apps" [fillcolor="pink"];
    "apps.badges" [fillcolor="pink"];
    "apps.badges.admin" [fillcolor="pink"];
    "apps.badges.apps" [fillcolor="pink"];
    "apps.badges.forms" [fillcolor="pink"];
    "apps.badges.migrations" [fillcolor="pink"];
    "apps.badges.migrations.0001_initial" [fillcolor="pink"];
    "apps.badges.migrations.0002_alter_touristobject_type" [fillcolor="pink"];
    "apps.badges.migrations.0003_osmtypemapping_peakmodel" [fillcolor="pink"];
    "apps.badges.migrations.0004_touristobject_local_names_and_more" [fillcolor="pink"];
    "apps.badges.migrations.0005_alter_touristobject_is_active" [fillcolor="pink"];
    "apps.badges.migrations.0006_alter_badgetiermodel_name" [fillcolor="pink"];
    "apps.badges.migrations.0007_badgeversionmodel_rules_text_and_more" [fillcolor="pink"];
    "apps.badges.migrations.0008_alter_badgeversionmodel_rules" [fillcolor="pink"];
    "apps.badges.migrations.0009_badgemodel_is_booklet_required_and_more" [fillcolor="pink"];
    "apps.badges.migrations.0010_touristobject_existence_end_and_more" [fillcolor="pink"];
    "apps.badges.migrations.0011_delete_peakmodel" [fillcolor="pink"];
    "apps.badges.migrations.0012_badgetiermodel_unique_tier_name_per_version_and_more" [fillcolor="pink"];
    "apps.badges.migrations.0013_touristobject_osm_error_touristobject_status" [fillcolor="pink"];
    "apps.badges.migrations.0014_proximitycandidate" [fillcolor="pink"];
    "apps.badges.migrations.0015_touristobject_last_sync_check_osmsyncconflict" [fillcolor="pink"];
    "apps.badges.models" [fillcolor="pink"];
    "apps.badges.tasks" [fillcolor="pink"];
    "apps.badges.tests" [fillcolor="pink"];
    "apps.badges.views" [fillcolor="pink"];
  }

  "application.dto.ascent_dto" -> "domain.value_objects.ascent";
  "application.dto.verify_badge_dto" -> "application.dto.ascent_dto";
  "application.ports.badge_repository_port" -> "domain.entities.badge_version";
  "application.ports.user_progress_port" -> "application.dto.ascent_dto";
  "application.ports.user_progress_port" -> "application.dto.user_context_dto";
  "application.use_cases.build_tourist_region_geometry" -> "application.exceptions";
  "application.use_cases.calculate_object_regions" -> "application.exceptions";
  "application.use_cases.calculate_object_regions" -> "application.ports.clock_port";
  "application.use_cases.fetch_osm_data" -> "application.exceptions";
  "application.use_cases.fetch_osm_data" -> "application.ports.clock_port";
  "application.use_cases.log_ascent" -> "application.dto.ascent_dto";
  "application.use_cases.log_ascent" -> "application.exceptions";
  "application.use_cases.log_ascent" -> "application.ports.clock_port";
  "application.use_cases.log_ascent" -> "application.ports.user_progress_port";
  "application.use_cases.verify_badge" -> "application.dto.verify_badge_dto";
  "application.use_cases.verify_badge" -> "application.exceptions";
  "application.use_cases.verify_badge" -> "application.ports.badge_repository_port";
  "application.use_cases.verify_badge" -> "domain.exceptions";
  "apps.badges.admin" -> "apps.badges.forms";
  "apps.badges.admin" -> "apps.badges.models";
  "apps.badges.admin" -> "apps.badges.tasks";
  "apps.badges.forms" -> "apps.badges.models";
  "apps.badges.models" -> "infrastructure.schemas.badge_rules_schema";
  "apps.badges.tasks" -> "application.exceptions";
  "apps.badges.tasks" -> "infrastructure.adapters.osm_adapter";
  "domain.entities.badge_version" -> "domain.exceptions";
  "domain.entities.badge_version" -> "domain.rules.badge_rules";
  "domain.entities.badge_version" -> "domain.value_objects.ascent";
  "domain.rules.badge_rules" -> "domain.value_objects.ascent";
  "infrastructure.adapters.osm_adapter" -> "apps.badges.models";
  "infrastructure.adapters.osm_adapter" -> "infrastructure.exceptions";
  "infrastructure.adapters.osm_repository" -> "apps.badges.models";
  "infrastructure.adapters.osm_repository" -> "infrastructure.adapters.osm_adapter";
  "infrastructure.adapters.persistence.django_badge_repo" -> "application.ports.badge_repository_port";
  "infrastructure.adapters.persistence.django_badge_repo" -> "apps.badges.models";
  "infrastructure.adapters.persistence.django_badge_repo" -> "domain.entities.badge_version";
  "infrastructure.adapters.persistence.django_badge_repo" -> "domain.rules.badge_rules";
  "infrastructure.adapters.persistence.region_cache_repo" -> "apps.badges.models";
  "infrastructure.config" -> "infrastructure.config.app_settings";
  "infrastructure.logging" -> "infrastructure.logging.log_config";
}
